<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ublox_rtv_outputs</name>
  <version>0.7.6</version>
  <description>Standard ROS outputs (NavSatFix with RTK status, GPSFix, twist, time reference, RtkStatus, diagnostics) from the ublox_dgnss UBX topics, as the rtv_gnss ZED-F9P driver publishes them</description>
  <maintainer email="geoff.s@cmpeng.com.au">Geoff Sokoll</maintainer>
  <license>Apache License, Version 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>gps_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rtv_gnss_utils</depend>
  <depend>sensor_msgs</depend>
  <depend>ublox_ubx_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
